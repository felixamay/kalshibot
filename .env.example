# Application
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://kalshi:kalshi@localhost:5432/kalshi_signals
DATABASE_URL_SYNC=postgresql://kalshi:kalshi@localhost:5432/kalshi_signals

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Kalshi Production API (READ-ONLY — never used to place orders)
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PEM=
KALSHI_USE_AUTH=true

# Live matches come from Live Tennis API GET /matches?status=live, then link to Kalshi contracts.
TENNIS_PROVIDER=livetennis
TENNIS_API_KEY=
TENNIS_API_BASE_URL=https://api.livetennisapi.com/api/public/v1
TENNIS_POLL_INTERVAL_SECONDS=5

# Strategy / signal parameters
# Unused as a wait. Pattern suggestions follow the live match stage, not a 5-minute clock.
INITIAL_OBSERVATION_SECONDS=0
WATCH_CONFIDENCE=72
MIN_BET_CONFIDENCE=80
STRONG_BET_CONFIDENCE=90
MIN_NET_EDGE=0.02
EXCELLENT_MARKET_MIN_EDGE=0.015
MEDIUM_MARKET_MIN_EDGE=0.03
POOR_MARKET_MIN_EDGE=0.04
STRONG_NET_EDGE=0.045
ENTRY_CONFIRMATION_COUNT=3
MAX_SIGNALS_PER_MATCH=4
PATTERN_ENGINE_ENABLED=true
MIN_PATTERN_OCCURRENCES=2
PATTERN_WATCH_SCORE=65
PATTERN_ENTRY_SCORE=75
STRONG_PATTERN_ENTRY_SCORE=87
MIN_PATTERN_CONFIDENCE=70
PATTERN_CONFIRMATION_COUNT=3
PATTERN_LATE_STAGE_PERCENT=75
PATTERN_COMPLETED_PERCENT=95
PATTERN_WEAKEN_HEALTH=60
PATTERN_RISK_HEALTH=40
PATTERN_BROKEN_HEALTH=25
PATTERN_EVAL_INTERVAL_MS=500
REENTRY_COOLDOWN_SECONDS=60
MIN_SIGNAL_TTL_SECONDS=2
DEFAULT_SIGNAL_TTL_SECONDS=8
MAX_SIGNAL_TTL_SECONDS=30
SIGNAL_TIMER_REFRESH_MS=100
MAX_DATA_AGE_MS=5000
MAX_SPREAD_CENTS=6
MIN_LIQUIDITY_CONTRACTS=50
MAX_ENTRY_SLIPPAGE_CENTS=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
